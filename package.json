{
  "name": "promptpro",
  "version": "1.1.0",
  "description": "AI 提示词优化器 + 模板库 Chrome 插件",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/scan-extension-secrets.mjs",
    "build:dev": "tsc && vite build --mode extension-dev",
    "preview": "vite preview",
    "test:p0": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:p0-03": "node --experimental-strip-types scripts/run-p0-03-benchmark.mjs",
    "benchmark:structured": "node --experimental-strip-types scripts/run-structured-benchmark.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
